# Loon 候选模板，节点注入与设备验证尚未完成。
# 由 Personal/build.py 生成；规则与分组修改请编辑个人 INI。
[General]
dns-server = system, 119.29.29.29, 223.5.5.5
sni-sniffing = true
udp-fallback-mode = REJECT
allow-wifi-access = false
interface-mode = auto
test-timeout = 5

[Proxy]
# 由支持 Loon 模板的生成器注入实际节点。

[Proxy Group]
🚀 节点选择 = select, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换, DIRECT
🚀 手动切换 = select, NameRegexFilter = .*
🤖 AI 服务 = select, 🇺🇸 美国节点, 🇯🇵 日本节点
🐦 Twitter = select, 🇺🇸 美国节点, 🇯🇵 日本节点, 🇭🇰 香港节点, 🚀 节点选择
📰 刷帖 = select, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点
📲 电报消息 = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换, DIRECT
📹 油管视频 = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换, DIRECT
🎶 TikTok = select, 🇯🇵 日本节点, 🇺🇸 美国节点, 🇭🇰 香港节点
🎥 奈飞视频 = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换, DIRECT
📺 巴哈姆特 = select, 🚀 节点选择, 🚀 手动切换, DIRECT
📺 哔哩哔哩 = select, 🎯 全球直连, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点
🌍 国外媒体 = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换, DIRECT
🌏 国内媒体 = select, DIRECT, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换
🔍 谷歌服务 = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点
🐱 Github = select, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, DIRECT
📢 谷歌FCM = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
Ⓜ️ 微软Bing = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
Ⓜ️ 微软云盘 = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
Ⓜ️ 微软服务 = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
🍎 苹果服务 = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
🎮 游戏平台 = select, DIRECT, 🚀 节点选择, 🇺🇸 美国节点, 🇭🇰 香港节点, 🇯🇵 日本节点, 🚀 手动切换
🎮 Steam = select, DIRECT, 🚀 节点选择, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点
🎶 网易音乐 = select, DIRECT, 🚀 节点选择, NameRegexFilter = (网易|音乐|解锁|Music|NetEase)
🎯 全球直连 = select, DIRECT, 🚀 节点选择
🛑 广告拦截 = select, REJECT, DIRECT
🍃 应用净化 = select, REJECT, DIRECT
🐟 漏网之鱼 = select, 🚀 节点选择, DIRECT, 🇭🇰 香港节点, 🇺🇸 美国节点, 🇯🇵 日本节点, 🚀 手动切换
🇭🇰 香港节点 = select, NameRegexFilter = (?i)(^HK[ ._-]|香港|Hong[ _-]?Kong|🇭🇰)
🇺🇸 美国节点 = select, NameRegexFilter = (?i)(^US[ ._-]|美国|美西|United[ _-]?States|🇺🇸)
🇯🇵 日本节点 = select, NameRegexFilter = (?i)(^JP[ ._-]|日本|东京|Japan|Tokyo|🇯🇵)

[Rule]
DOMAIN-SUFFIX,nodeseek.com,📰 刷帖
DOMAIN-SUFFIX,v2ex.com,📰 刷帖
DOMAIN-SUFFIX,linux.do,📰 刷帖
FINAL,🐟 漏网之鱼

